# Copy values into your trusted secret manager or shell environment.
# Never commit real values.
IMAGE_REF=ghcr.io/udienz/codex-microvm:latest
# Existing application API token; do not add it to source control.
# API_BEARER_TOKEN is injected when creating/updating the MicroVM.
# Private browser dashboard (stage 1):
# STUDIO_PASSWORD_HASH=pbkdf2_sha256$600000$<salt-hex>$<hash-hex>
# STUDIO_SESSION_SECRET=<random secret generated locally>
# STUDIO_COOKIE_SECURE=true
# DIGITALOCEAN_TOKEN is used only by doctl/client calls, never by the workload.
